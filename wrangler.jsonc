// Cloudflare Workers deploy config — working copy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airap-video",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_NAME": "Airap Video",
    "VITE_APP_URL": "https://airap-video.net",
    "ALIBABA_BASE_URL": "https://ws-2txa9apyfxruykae.us-east-1.maas.aliyuncs.com/compatible-mode/v1",
    "ALIBABA_MODEL": "deepseek-v4.1-flash-1017",
    "KIE_BASE_URL": "https://api.kie.ai/api/v1",
    "RAP_VIDEO_MODEL": "wan3.0-video",
    "RAP_VIDEO_RESOLUTION": "480p",
    "LINEART_TRANSCODER_URL": "https://airap-transcoder.onrender.com",
    "R2_ACCOUNT_ID": "a9246b06d96e713031083e5a08343901",
    "R2_ACCESS_KEY": "15766228e0b8a673a980a4714df09fee",
    "R2_SECRET_KEY": "7c9123ed311721c6a9b2cac84bcd699ef21a05ca4b27a6f92a85e370c31638b7",
    "R2_BUCKET_NAME": "airap-video-storage",
    "R2_DOMAIN": "https://pub-5e8c263fe2a34ea4bb036f8b72d808ca.r2.dev",
    "R2_ENDPOINT": "https://a9246b06d96e713031083e5a08343901.r2.cloudflarestorage.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airap-video-db",
      "database_id": "de3a1a0e-96fa-44f2-a233-afceba54f8cc",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROVIDER_GENERATE_RATE_LIMITER",
        "class_name": "ProviderGenerateRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "provider-generate-rate-limiter-v1",
      "new_sqlite_classes": ["ProviderGenerateRateLimiter"]
    }
  ],
  "triggers": {
    "crons": ["0 16 * * *"]
  }
}
